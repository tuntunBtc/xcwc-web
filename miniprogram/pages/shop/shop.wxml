<page-meta page-style="{{panelVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="shop-page">
    <!-- 商城内容区与透明底栏背后的底图。 -->
    <image class="page-scene" src="/assets/shop/felt/page-background.webp" mode="scaleToFill" style="height:{{viewportHeight}}rpx"></image>

    <!-- 品牌条移到胶囊同排：整块按一个系数等比缩放，不单独压缩宽度；
         右边界由 shop-layout.js 按真实胶囊左缘留出间隙，不遮挡右上角圆圈。 -->
    <view class="masthead" style="top:{{mastheadTop}}rpx;left:{{mastheadLeft}}rpx;transform:scale({{mastheadScale}})">
        <image class="masthead-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
        <view class="brand">
            <view class="brand-mark">
                <image class="brand-icon" src="/assets/shop/icons/bird.png" mode="aspectFit"></image>
            </view>
            <view class="brand-text">
                <text class="brand-name">小鸟商城</text>
                <text class="brand-en">BIRD CITY DIARY</text>
            </view>
        </view>
        <view class="cart-icon" bindtap="handleOpenCart">
            <image class="cart-img" src="/assets/shop/icons/cart.png" mode="aspectFit"></image>
            <view wx:if="{{cartCount && !cartReadFailed}}" class="cart-count">{{cartCount}}</view>
            <!-- 品牌条等比缩小后仍有更大的透明点按范围。 -->
            <view class="cart-hit"></view>
        </view>
    </view>

    <!-- 用当前橱窗图的上沿铺进品牌条与系统状态栏。 -->
    <view class="status-space" style="height: calc({{headerSpace}}rpx + 1px);" aria-hidden="true">
        <block wx:if="{{banners.length}}">
            <image class="hero-top-art" src="{{banners[bannerIndex].image}}" mode="aspectFill"></image>
            <view class="hero-top-shade"></view>
        </block>
    </view>

    <view class="app">
        <view class="hero">
            <swiper class="hero-swiper" autoplay="{{bannerAutoplay && !panelVisible}}" interval="5000" circular="{{true}}" current="{{bannerIndex}}" bindchange="handleSlide">
                <swiper-item wx:for="{{banners}}" wx:key="id">
                    <image class="hero-image" src="{{item.image}}" mode="aspectFill"></image>
                </swiper-item>
            </swiper>
            <scroll-view wx:if="{{bannerDots}}" class="hero-dots" scroll-x
                scroll-into-view="{{'shop-banner-dot-' + bannerIndex}}"
                style="width: max({{banners.length * 88}}rpx, {{banners.length * 44}}px);">
                <view class="hero-dot-list">
                    <view wx:for="{{banners}}" wx:key="id" id="shop-banner-dot-{{index}}" class="hero-dot-hit"
                        data-index="{{index}}" role="button" aria-label="{{'切换到第 ' + (index + 1) + ' 张轮播图'}}" bindtap="handleDot">
                        <view class="hero-dot {{index === bannerIndex ? 'is-active' : ''}}" aria-hidden="true"></view>
                    </view>
                </view>
            </scroll-view>
            <view wx:if="{{bannerDots}}" class="carousel-pause" role="button" bindtap="handleCarouselPause">{{carouselPaused ? '继续轮播' : '暂停轮播'}}</view>
        </view>

        <view class="intro">
            <image class="intro-texture" src="/assets/shop/felt/cream-panel.webp" mode="scaleToFill"></image>
            <view class="intro-copy">
                <text class="eyebrow">A LITTLE BIRD, A NEW JOURNEY</text>
                <text class="intro-title">把一座城市，带回家。</text>
                <text class="intro-desc">遇见城市限定小鸟，收藏属于你的旅行记忆</text>
            </view>
            <view class="intro-stamp">
                <image class="stamp-bg" src="/assets/shop/felt/cream-panel.webp" mode="scaleToFill"></image>
                <text class="stamp-line">城市限定</text>
                <text class="stamp-line">温暖相伴</text>
                <view class="stamp-leaf"></view>
            </view>
        </view>

        <view class="benefit">
            <image class="benefit-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
            <text class="egg-art">🥚</text>
            <text class="benefit-copy">绑定实体小鸟，解锁对应城市鸟蛋</text>
            <view class="benefit-action" bindtap="handleRules">
                <text class="benefit-action-text">了解规则</text>
                <text class="benefit-action-arrow">›</text>
            </view>
        </view>

        <view class="toolbar">
            <view class="category">
                <view class="category-title">
                    <image class="category-icon" src="/assets/shop/icons/happy.webp" mode="aspectFit"></image>
                    <text>全部小鸟</text>
                </view>
                <text class="result-count">共 {{total}} 只城市小鸟</text>
            </view>
            <view class="filters">
                <view class="filter" bindtap="handleSortDefault">
                    <image class="filter-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
                    <text class="filter-label">综合排序</text>
                </view>
                <view class="filter {{sort !== 'default' ? 'is-active' : ''}}" bindtap="handleSortPrice">
                    <image class="filter-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
                    <image wx:if="{{sort !== 'default'}}" class="filter-bg" src="/assets/shop/felt/green-button.webp" mode="scaleToFill"></image>
                    <text class="filter-label">{{sortLabel}}</text>
                </view>
                <view class="filter city-filter">
                    <image class="filter-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
                    <picker class="city-picker" mode="selector" range="{{cityNames}}" value="{{cityIndex}}" bindchange="handleCityChange">
                        <view class="filter-inner">
                            <text class="filter-label">{{cityLabel}}</text>
                            <text class="filter-arrow">▾</text>
                        </view>
                    </picker>
                </view>
            </view>
        </view>

        <view wx:if="{{emptyVisible}}" class="shop-status">该城市暂无商品，去看看其他城市的小鸟吧。</view>
        <view wx:if="{{emptyVisible}}" class="shop-retry" bindtap="handleClearCity"><text class="retry-text">查看全部城市</text></view>
        <view wx:if="{{coversFailed}}" class="shop-retry">
            <view class="shop-status" role="status">部分商品图片暂时无法加载，可继续浏览。</view>
            <button class="retry-text cover-retry" disabled="{{coversLoading}}" bindtap="loadProductCovers">{{coversLoading ? '正在重试…' : '重试商品图片'}}</button>
        </view>

        <view class="products">
            <view class="card {{item.isLeft ? 'card-left' : ''}}" wx:for="{{visibleProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="handleOpen">
                <image class="card-bg" src="/assets/shop/felt/card.webp" mode="scaleToFill"></image>
                <image class="photo" src="{{readyCovers[item.id] ? item.cover : '/assets/shop/felt/cream-panel.webp'}}" mode="aspectFill" lazy-load="{{true}}"
                    data-cover-id="{{item.id}}" data-cover-attempt="{{readyCovers[item.id] ? (coverAttempts[item.id] || 0) : -1}}" binderror="handleProductCoverError"></image>
                <view class="card-body">
                    <text class="product-name">{{item.title}}</text>
                    <text class="product-remark">{{item.remark}}</text>
                    <view class="card-bottom">
                        <text class="price">{{item.priceText}}</text>
                        <view class="add" data-id="{{item.id}}" catchtap="handleAdd">
                            <view class="add-circle {{item.added ? 'is-added' : ''}}"></view>
                            <text wx:if="{{item.added}}" class="add-check">✓</text>
                            <image wx:else class="add-icon" src="/assets/shop/icons/cart-white.png" mode="aspectFit"></image>
                        </view>
                    </view>
                </view>
            </view>
        </view>

        <view class="end">一鸟一城 · 旅途未完待续</view>
    </view>

    <view wx:if="{{panelVisible}}" class="overlay" style="padding-top:{{topInset}}rpx">
        <view class="overlay-backdrop" bindtap="handleClose" catchtouchmove="noop"></view>
        <view class="panel" catchtap="noop">
            <view class="panel-head">
                <image class="panel-head-bg" src="/assets/shop/felt/pink-pill.webp" mode="scaleToFill"></image>
                <text class="panel-title">{{panelTitle}}</text>
                <view class="panel-close" bindtap="handleClose"><text class="close-mark">×</text></view>
            </view>
            <scroll-view scroll-y scroll-into-view="{{'shop-panel-start-' + panelKind}}" class="panel-content {{panelKind === 'rules' || panelKind === 'added' ? 'is-short' : ''}}">
                <view id="{{'shop-panel-start-' + panelKind}}" class="panel-start" aria-hidden="true"></view>
                <block wx:if="{{panelKind === 'detail'}}">
                    <image class="detail-cover" src="{{readyCovers[detail.id] ? detail.cover : '/assets/shop/felt/cream-panel.webp'}}" mode="aspectFill"
                        data-cover-id="{{detail.id}}" data-cover-attempt="{{readyCovers[detail.id] ? (coverAttempts[detail.id] || 0) : -1}}" binderror="handleProductCoverError"></image>
                    <view class="detail-body">
                        <text class="detail-title">{{detail.title}}</text>
                        <text class="detail-remark">{{detail.city}} · {{detail.remark}}</text>
                        <text class="detail-price">{{detail.priceText}}</text>
                        <view class="detail-divider"></view>
                        <text class="detail-desc">{{detail.description}}</text>
                        <text class="detail-note">商品价格与库存以实际售卖页面为准。当前小程序不提供站内下单、支付与订单，也不因浏览或加购发放鸟蛋。</text>
                        <view class="detail-text-head" bindtap="handleTextToggle">
                            <text>商品文字信息</text>
                            <text class="detail-text-arrow">{{detailTextOpen ? '−' : '+'}}</text>
                        </view>
                        <view wx:if="{{detailTextOpen}}" class="detail-text-block">
                            <text class="detail-text-line">参考价格：{{detail.priceText}}</text>
                            <text class="detail-text-line">所属城市：{{detail.city}}</text>
                            <text class="detail-text-line">{{detail.remark}}</text>
                        </view>
                        <view class="detail-add-btn" data-id="{{detail.id}}" bindtap="handleDetailAdd">
                            <image class="button-bg" src="/assets/shop/felt/green-button.webp" mode="scaleToFill"></image>
                            <text class="detail-add-label">{{detail.added ? '已在购物车中' : '加入购物车'}}</text>
                        </view>
                    </view>
                </block>

                <block wx:elif="{{panelKind === 'cart'}}">
                    <view wx:if="{{cartReadFailed}}" class="detail-body">
                        <view class="cart-empty">暂时无法读取本机购物车，请重试。</view>
                        <view class="primary-btn" bindtap="handleOpenCart">
                            <image class="button-bg" src="/assets/shop/felt/green-button.webp" mode="scaleToFill"></image>
                            <text class="primary-label">重新读取</text>
                        </view>
                    </view>
                    <view wx:else class="detail-body">
                        <text class="cart-panel-status">我的购物车 · {{cartCount}} 只小鸟</text>
                        <view wx:if="{{cartCount === 0}}" class="cart-empty">还没有小鸟来做客，把喜欢的小鸟加入购物车吧。</view>
                        <view wx:for="{{cartItems}}" wx:key="id" class="cart-row">
                            <image class="cart-cover" src="{{readyCovers[item.id] ? item.cover : '/assets/shop/felt/cream-panel.webp'}}" mode="aspectFill"
                                data-cover-id="{{item.id}}" data-cover-attempt="{{readyCovers[item.id] ? (coverAttempts[item.id] || 0) : -1}}" binderror="handleProductCoverError"></image>
                            <view class="cart-copy">
                                <text class="cart-name">{{item.title}}</text>
                                <text class="cart-price">{{item.priceText}}</text>
                                <view class="cart-actions">
                                    <text class="cart-buy" bindtap="handleBuy">购买暂未开通</text>
                                    <text class="cart-remove" data-id="{{item.id}}" catchtap="handleCartRemove">移除</text>
                                </view>
                            </view>
                        </view>
                        <text class="cart-note">购物车只保存在本机，不代表已下单；当前小程序不跳淘宝、不支付、不产生订单，清除缓存会清空记录。</text>
                        <view wx:if="{{cartCount === 0}}" class="primary-btn" bindtap="handleClose">
                            <image class="button-bg" src="/assets/shop/felt/green-button.webp" mode="scaleToFill"></image>
                            <text class="primary-label">继续逛逛</text>
                        </view>
                    </view>
                </block>

                <block wx:elif="{{panelKind === 'added'}}">
                    <view class="detail-body">
                        <image class="added-cover" src="{{readyCovers[detail.id] ? detail.cover : '/assets/shop/felt/cream-panel.webp'}}" mode="aspectFill"
                            data-cover-id="{{detail.id}}" data-cover-attempt="{{readyCovers[detail.id] ? (coverAttempts[detail.id] || 0) : -1}}" binderror="handleProductCoverError"></image>
                        <text class="added-title">{{detail.title}}</text>
                        <text class="added-note">{{addedAlready ? '这只小鸟已在购物车中' : '已加入购物车'}}，可前往购物车查看。</text>
                        <view class="primary-btn" bindtap="handleOpenCart">
                            <image class="button-bg" src="/assets/shop/felt/green-button.webp" mode="scaleToFill"></image>
                            <text class="primary-label">去购物车看看</text>
                        </view>
                        <view class="ghost-btn" bindtap="handleClose"><text>继续逛逛</text></view>
                    </view>
                </block>

                <block wx:else>
                    <view class="rules">
                        <text class="rules-title">一颗鸟蛋，一段城市旅程</text>
                        <text class="rules-line">碰一碰实体小鸟或扫描已建档链接，即可在本机领取属于你的城市小鸟。</text>
                        <text class="rules-line">挑选喜欢的城市小鸟加入本机购物车；购物车不代表已下单，当前不提供淘宝跳转、站内支付与订单管理。</text>
                        <text class="rules-line">浏览或加购商品不会领取小鸟、发放鸟蛋或叽分；调试期数据只保存在本机，不跨设备同步。</text>
                    </view>
                </block>
            </scroll-view>
        </view>
    </view>

    <view wx:if="{{toastVisible}}" class="toast"><text>{{toastText}}</text></view>
</view>
