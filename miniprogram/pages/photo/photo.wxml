<!-- 打卡合照：按网页端 src/checkin-template.html + checkin-page.css 逐区块复刻。
     1px = 2rpx（H5 CSS px 与 375px 视口设备 px 1:1）。WXSS 不支持本地
     background-image / 伪元素 / <details> / 内联 SVG，故纹理用 <image> 铺底，
     折叠区与弹层用 view + 数据绑定，图标用烘焙 PNG。 -->
<page-meta page-style="{{viewer || deleteConfirm ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="photo-page">
    <image class="page-meadow" src="/pages/photo/assets/meadow.webp" mode="scaleToFill" style="height:{{viewportHeight}}rpx" aria-hidden="true"></image>

    <!-- 把场景上沿延伸到状态栏，标题和按钮继续避开微信胶囊。 -->
    <view class="immersive-top" style="height:calc({{topInset}}rpx + 1px)" aria-hidden="true">
        <image class="hero-top-art" src="/pages/photo/assets/hero.webp" mode="scaleToFill"></image>
        <view class="hero-top-shade"></view>
    </view>

    <view class="app-shell">
        <!-- 主视觉 -->
        <view class="hero">
            <image class="hero-bg" src="/pages/photo/assets/hero.webp" mode="scaleToFill"></image>
            <view class="topbar">
                <view class="back" bindtap="onBack" hover-class="ui-hover">‹</view>
                <view class="brand">
                    <text class="brand-cn">小鸟伴游</text>
                    <text class="brand-en">TRAVEL DIARY</text>
                </view>
                <view class="points-pill" bindtap="onPoints" hover-class="ui-hover">
                    <image class="pill-icon" src="/pages/photo/assets/icon-spark.png" mode="aspectFit"></image>
                    <text class="pill-num">{{points}}</text>
                    <text class="pill-unit">叽分</text>
                </view>
            </view>
            <view class="wood-title">
                <view class="hero-kicker">
                    <text>把美好，留在这一刻</text>
                    <image src="/pages/photo/assets/icon-camera.png" mode="aspectFit"></image>
                </view>
                <view class="hero-title">打卡合照</view>
                <view class="hero-sub">记录我和小鸟的旅行日记</view>
            </view>
            <view class="hero-bubble">今天也想和你合个影 ♡</view>
        </view>

        <view class="main">
            <!-- 1. 选择出镜小鸟 -->
            <view class="panel birds-panel">
                <image class="tex-bg" src="/pages/photo/assets/cream.webp" mode="scaleToFill"></image>
                <view class="panel-body">
                    <view class="section-title">
                        <view class="section-h2">
                            <image class="leaf-icon" src="/pages/photo/assets/icon-leaf.png" mode="aspectFit"></image>
                            <text>选择出镜小鸟</text>
                        </view>
                        <view class="count-pill"><text class="count-num">{{selectedCount}}</text> / 3</view>
                    </view>
                    <view class="section-desc">最多选择 3 只已领取的小鸟一起合照</view>

                    <view wx:if="{{dataError}}" class="checkin-error">
                        <text class="error-text">{{dataError}}</text>
                        <view class="error-btn" bindtap="onRetryData">重新读取小鸟资料</view>
                    </view>
                    <view wx:if="{{noBirds}}" class="checkin-help">还没有领取小鸟。碰一碰实体小鸟的 NFC，或扫描包装二维码，领取后再来合照。</view>

                    <scroll-view wx:if="{{birds.length > 0}}" class="bird-scroller" scroll-x="true" enable-flex="true">
                        <view wx:for="{{birds}}" wx:key="id" class="bird-card {{item.selected ? 'selected' : ''}} {{item.adopted ? '' : 'locked'}}"
                              data-id="{{item.id}}" bindtap="onBirdTap" hover-class="ui-hover">
                            <view class="bird-portrait">
                                <image src="/pages/photo/assets/bird.webp" mode="aspectFit"></image>
                                <view class="bird-badge">
                                    <image src="{{item.adopted ? '/pages/photo/assets/icon-check.png' : '/pages/photo/assets/icon-lock.png'}}" mode="aspectFit"></image>
                                </view>
                            </view>
                            <text class="bird-name">{{item.name}}</text>
                            <text class="bird-state">{{item.adopted ? '已领取' : '未领取'}}</text>
                        </view>
                    </scroll-view>
                    <view wx:else class="bird-empty">
                        <image class="bird-empty-art" src="/pages/photo/assets/bird.webp" mode="aspectFit"></image>
                        <view class="bird-empty-copy"><text>还没有领取小鸟</text><text>领取后，带它一起合照吧</text></view>
                    </view>

                    <view class="selection-summary">
                        <text class="summary-text">{{selectedSummary}}</text>
                        <text class="swipe-note">向左滑动查看更多 →</text>
                    </view>
                </view>
            </view>

            <!-- 2. 选照片、风格、地点、编辑、生成 -->
            <view class="panel compose-panel">
                <image class="tex-bg" src="/pages/photo/assets/cream.webp" mode="scaleToFill"></image>
                <image class="compose-flower" src="/pages/photo/assets/flower.png" mode="aspectFit"></image>
                <view class="panel-body">
                    <view class="composer-grid">
                        <view class="upload-section">
                            <view class="step-title"><text class="step-no">1</text><text>选择照片</text></view>
                            <view class="upload {{uploaded ? 'has-image' : ''}}" bindtap="onChoosePhoto" hover-class="ui-hover">
                                <image wx:if="{{uploaded}}" class="upload-thumb" src="{{uploadThumb}}" mode="aspectFill"></image>
                                <view wx:else class="upload-prompt">
                                    <view class="upload-icon">
                                        <image src="/pages/photo/assets/icon-image.png" mode="aspectFit"></image>
                                        <text class="upload-plus">＋</text>
                                    </view>
                                    <text class="upload-strong">点击选择照片</text>
                                    <text class="upload-small">人像、风景都可以</text>
                                </view>
                                <view wx:if="{{uploaded}}" class="replace">更换照片 ↻</view>
                            </view>
                            <view class="upload-formats">手机照片 / JPG / PNG / WEBP</view>
                            <view class="upload-note">最大 15 MB · 照片在本机处理，不上传云端</view>
                        </view>
                        <view class="style-section">
                            <view class="step-title"><text class="step-no">2</text><text>选择风格</text><text class="step-optional">可选</text></view>
                            <view class="styles">
                                <view wx:for="{{styles}}" wx:key="name" class="style {{item.selected ? 'selected' : ''}}"
                                      data-index="{{index}}" bindtap="onStyleTap" hover-class="ui-hover">
                                    <image class="style-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
                                    <text class="style-name">{{item.name}}</text>
                                    <view wx:if="{{item.selected}}" class="style-check">✓</view>
                                </view>
                            </view>
                        </view>
                    </view>

                    <view class="location">
                        <image class="location-icon" src="/pages/photo/assets/icon-leaf.png" mode="aspectFit"></image>
                        <text class="location-label">这一站</text>
                        <input class="location-input" value="{{location}}" maxlength="20" placeholder="为回忆写下一个地点"
                               bindinput="onLocationInput" confirm-type="done" />
                    </view>

                    <!-- H5 <details> 的等价实现 -->
                    <view class="editor">
                        <view class="editor-summary" bindtap="toggleEditor" hover-class="ui-hover">
                            <view class="editor-summary-left">
                                <image class="editor-icon" src="/pages/photo/assets/icon-camera.png" mode="aspectFit"></image>
                                <text class="editor-title">{{previewTitle}}</text>
                                <text class="editor-badge">{{previewBadge}}</text>
                            </view>
                            <text class="editor-chevron {{editorOpen ? 'is-open' : ''}}">⌄</text>
                        </view>
                        <view wx:if="{{editorOpen}}" class="editor-body">
                            <view wx:if="{{assetError}}" class="checkin-error">
                                <text class="error-text">{{assetError}}</text>
                                <view class="error-btn" bindtap="onRetryAssets">重新加载合照素材</view>
                            </view>
                            <view class="photo-framing">
                                <text class="control-label">照片构图</text>
                                <picker class="framing-picker" range="{{photoFitOptions}}" value="{{photoFitIndex}}" bindchange="onPhotoFitChange">
                                    <view class="picker-value">{{photoFitName}} ▾</view>
                                </picker>
                                <view wx:if="{{showPhotoPositionX}}" class="photo-position">
                                    <text>照片左右位置</text>
                                    <slider class="position-slider" min="0" max="100" value="{{photoX}}" activeColor="#91a54d" block-size="20"
                                            bindchanging="onPhotoXChange" bindchange="onPhotoXChange" />
                                </view>
                                <view wx:if="{{showPhotoPositionY}}" class="photo-position">
                                    <text>照片上下位置</text>
                                    <slider class="position-slider" min="0" max="100" value="{{photoY}}" activeColor="#91a54d" block-size="20"
                                            bindchanging="onPhotoYChange" bindchange="onPhotoYChange" />
                                </view>
                            </view>
                            <view class="editor-tip">单指拖动小鸟，双指捏合或张开放大缩小</view>
                            <view class="photo-stack">
                                <view class="canvas-stage">
                                    <canvas type="2d" id="preview" class="preview-canvas" style="height:{{canvasHeightRpx}}rpx"
                                            disable-scroll="true" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove"
                                            bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel"></canvas>
                                    <view wx:if="{{selectionVisible}}" class="bird-selection"
                                          style="left:{{selectionBox.left}}%;top:{{selectionBox.top}}%;width:{{selectionBox.width}}%;height:{{selectionBox.height}}%">
                                        <text class="selection-name">{{activeName}}</text>
                                    </view>
                                </view>
                            </view>
                            <view class="active-bird-control">
                                <text class="control-label">正在调整的小鸟</text>
                                <picker class="bird-picker" range="{{activeNames}}" value="{{activeIndex}}" bindchange="onActiveBirdChange">
                                    <view class="picker-value">{{activeName}} ▾</view>
                                </picker>
                            </view>
                            <view class="adjust">
                                <text class="adjust-label">{{activeName}} · 小鸟大小</text>
                                <view class="adjust-btn" bindtap="onSmaller" hover-class="ui-hover">−</view>
                                <slider class="size-slider" min="12" max="55" value="{{size}}" activeColor="#91a54d" block-size="20"
                                        bindchanging="onSizeChange" bindchange="onSizeChange" />
                                <view class="adjust-btn" bindtap="onLarger" hover-class="ui-hover">＋</view>
                                <text class="size-value">{{sizeValue}}%</text>
                                <view class="reset-btn" bindtap="onResetBird" hover-class="ui-hover">复位当前小鸟</view>
                            </view>
                            <view class="preview-bottom">
                                <text class="preview-hint">双指缩放 · 单指移动</text>
                                <view class="download-btn {{downloadDisabled ? 'is-disabled' : ''}}" bindtap="onDownload" hover-class="ui-hover">
                                    <image src="/pages/photo/assets/icon-download.png" mode="aspectFit"></image>
                                    <text>查看大图</text>
                                </view>
                            </view>
                        </view>
                    </view>

                    <view class="draft-note">{{draftNote}}</view>
                    <view class="create-area">
                        <image class="generate-flower" src="/pages/photo/assets/flower.png" mode="aspectFit"></image>
                        <view class="generate {{generateDisabled && !generateCanChoosePhoto && !generateCanManageAlbum ? 'is-disabled' : ''}}"
                              role="button" aria-disabled="{{generateDisabled && !generateCanChoosePhoto && !generateCanManageAlbum}}"
                              bindtap="onPrimaryAction" hover-class="ui-hover">
                            <image class="generate-camera" src="/pages/photo/assets/icon-camera.png" mode="aspectFit"></image>
                            <text class="generate-text">{{generateText}}</text>
                            <image class="generate-arrow" src="/pages/photo/assets/icon-arrow.png" mode="aspectFit"></image>
                        </view>
                        <view class="reward-line">
                            <image src="/pages/photo/assets/icon-spark.png" mode="aspectFit"></image>
                            <text>新原图合照 <text class="reward-strong">+1 叽分</text> · 每日最多 3 次 <text class="reward-spark">✧</text></text>
                        </view>
                    </view>
                </view>
            </view>

            <!-- 3. 本机打卡相册 -->
            <view class="album-section">
                <view class="album-heading">
                    <view class="album-heading-left">
                        <view class="album-title">我的打卡合照 <text class="album-count">{{albumTotal}}</text></view>
                        <view class="album-desc">和喜欢的伙伴，收藏每一次出发</view>
                    </view>
                    <view class="album-actions">
                        <view wx:if="{{manageVisible}}" class="album-action" bindtap="onManageAlbum" hover-class="ui-hover">{{manageText}}</view>
                        <view wx:if="{{viewAllVisible}}" class="album-action" bindtap="onViewAll" hover-class="ui-hover">{{viewAllText}}</view>
                    </view>
                </view>
                <view class="album-capacity">{{albumCapacityText}}</view>
                <view wx:if="{{albumError}}" class="checkin-error">
                    <text class="error-text">{{albumError}}</text>
                    <view class="error-btn" bindtap="onRetryAlbum">重试读取相册</view>
                </view>
                <view wx:if="{{albumFullVisible}}" class="checkin-error">
                    <text class="error-text">相册已满。请先保存重要照片，再删除不需要的合照腾出空间。</text>
                    <view class="error-btn" bindtap="onManageFull">去管理合照</view>
                </view>
                <view class="gallery">
                    <view wx:for="{{albumEntries}}" wx:key="id" class="memory-card">
                        <view class="memory" data-id="{{item.id}}" bindtap="onMemoryTap" hover-class="ui-hover">
                            <image class="memory-image" src="{{item.image}}" mode="aspectFill"></image>
                            <view class="memory-body">
                                <text class="memory-label">{{item.label}}</text>
                                <view class="memory-meta">
                                    <text class="memory-date">{{item.dateText}}</text>
                                    <text class="memory-badge">{{item.badge}}</text>
                                </view>
                            </view>
                        </view>
                        <view wx:if="{{albumManaging}}" class="delete-memory" data-id="{{item.id}}" bindtap="onDeleteTap">删除合照</view>
                    </view>
                </view>
                <view class="album-foot">{{albumFoot}}</view>
            </view>

            <view class="demo-note">仅已领取小鸟可出镜 · 重复原图只收藏、不重复加分</view>
        </view>

        <view class="footer"><text class="footer-flower">✿</text> 世界很大，我们慢慢逛 <text class="footer-flower">✿</text></view>
    </view>

    <!-- 与网页端一致的四项公共底栏（非 tab 页显式复用同一组件） -->
    <photo-tab-bar></photo-tab-bar>

    <view wx:if="{{toast}}" class="toast" style="bottom:{{toastBottom}}rpx">{{toast}}</view>

    <view wx:if="{{deleteConfirm}}" class="viewer-mask" style="padding-top:{{topInset}}rpx;padding-bottom:{{viewerBottomInset}}rpx">
        <view class="album-delete-backdrop" catchtap="onCancelDelete" catchtouchmove="noop"></view>
        <view class="viewer album-delete-dialog" role="dialog">
            <view class="delete-title">{{deleteTitle}}</view>
            <text class="error-text">将同时删除当前手机中的这张合照和原照片，无法恢复。请先保存重要照片。小鸟、叽分和已得奖励保持不变。</text>
            <view class="confirm-actions">
                <view class="confirm-btn" bindtap="onCancelDelete">{{deletePending ? '关闭' : '保留合照'}}</view>
                <view class="confirm-btn is-danger" bindtap="onConfirmDelete">确认删除</view>
            </view>
            <view wx:if="{{deleteStatus}}" class="delete-status">{{deleteStatus}}</view>
        </view>
    </view>

    <!-- 合照查看器：预览、生成完成、相册查看共用 -->
    <view wx:if="{{viewer}}" class="viewer-mask" style="padding-top:{{topInset}}rpx;padding-bottom:{{viewerBottomInset}}rpx" bindtap="onCloseViewer">
        <view class="viewer" catchtap="noop">
            <view class="viewer-header">
                <text class="viewer-title">打卡合照</text>
                <view class="viewer-close" catchtap="onCloseViewer">×</view>
            </view>
            <image class="viewer-image" src="{{viewer.image}}" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
            <view wx:if="{{viewer.meta}}" class="viewer-meta">{{viewer.meta}}</view>
            <view wx:if="{{viewer.note}}" class="viewer-note">{{viewer.note}}</view>
            <view class="viewer-save {{viewerSavePending ? 'is-pending' : ''}}" catchtap="onSavePhoto">{{viewerSavePending === 'menu' ? '正在打开保存菜单…' : (viewerSavePending === 'album' ? '正在保存…' : viewer.buttonText)}}</view>
            <view class="viewer-hint">{{viewer.hint}}</view>
            <view class="viewer-other">
                <view class="other-summary" catchtap="onOtherWays">{{viewer.otherOpen ? '▾' : '▸'}} 其他保存方式</view>
                <view wx:if="{{viewer.otherOpen}}" class="other-body">
                    <view class="other-note">下载到文件不会直接进入手机相册；优先使用上方保存或长按图片。</view>
                    <view class="other-btn" catchtap="onPreviewImage">在新页面预览大图（长按可保存）</view>
                </view>
            </view>
        </view>
    </view>
</view>
