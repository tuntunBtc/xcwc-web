<view class="page">
    <view class="hero">
        <text class="eyebrow">PROFILE · 我的</text>
        <text class="title">{{title}}</text>
        <text class="subtitle">{{subtitle}}</text>
    </view>

    <view class="card profile-card">
        <view class="avatar">{{avatarText}}</view>
        <view class="profile-main">
            <text class="nickname">{{displayNickname}}</text>
            <text class="muted">{{displayIntro}}</text>
        </view>
    </view>

    <view class="card">
        <text class="section-title">叽分</text>
        <view class="divider"></view>
        <view class="row"><text>当前余额</text><text>{{points}} 叽分</text></view>
        <view class="row"><text>今日获得</text><text>{{todayPoints}} / {{dailyLimit}}</text></view>
        <view class="row"><text>步数兑换</text><text>{{stepText}}</text></view>
    </view>

    <view class="menu-card card" wx:for="{{menuGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key">
        <view class="menu-item" wx:for="{{group.items}}" wx:for-item="menuItem" wx:for-index="itemIndex" wx:key="key" data-group="{{groupIndex}}" data-index="{{itemIndex}}" bindtap="handleMenuTap">
            <text class="menu-text">{{menuItem.text}}</text>
            <text class="menu-arrow">›</text>
        </view>
    </view>
</view>
