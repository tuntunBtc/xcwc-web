<view class="adopt-page">
    <view class="immersive-top" style="height: calc({{topInset}}rpx - 42rpx + 1px);" aria-hidden="true">
        <image class="immersive-top-art" src="/pages/adopt/assets/scene.webp" mode="scaleToFill"></image>
    </view>

    <view class="scene">
        <image class="scene-art" src="/pages/adopt/assets/scene.webp" mode="scaleToFill" aria-hidden="true"></image>
        <view class="scene-title">
            <text>领养你的</text>
            <text>城市小鸟</text>
        </view>
        <text class="scene-subtitle">一场相遇，正在等待确认</text>

        <view class="scroll-card">
            <text class="scroll-name">{{birdName}}</text>
            <view class="scroll-divider"></view>
            <text class="scroll-city">{{cityText}}</text>
            <text class="scroll-detail">{{styleText}}</text>
            <text class="scroll-detail">{{skinText}}</text>
        </view>

        <view class="trait-row">
            <text class="trait-label">性格档案</text>
            <text wx:for="{{traits}}" wx:key="*this" class="trait-pill pill-{{index}}">{{item}}</text>
        </view>
    </view>

    <view class="details">
        <image class="details-top" src="/pages/adopt/assets/lower-top.webp" mode="scaleToFill" aria-hidden="true"></image>
        <image class="details-bottom" src="/pages/adopt/assets/lower-bottom.webp" mode="widthFix" aria-hidden="true"></image>

        <view wx:if="{{notice}}" class="notice notice-{{noticeKind}}">
            <text class="notice-text">{{notice}}</text>
            <view wx:if="{{retryVisible}}" class="retry" bindtap="handleRetry"><text>重新读取小鸟资料</text></view>
        </view>

        <view class="form">
            <text class="name-heading">{{heading}}</text>
            <view class="name-field">
                <input
                    class="name-input"
                    value="{{nicknameInput}}"
                    maxlength="12"
                    disabled="{{!ready || alreadyMine || submitting}}"
                    placeholder="请输入 1–6 个字"
                    placeholder-class="name-placeholder"
                    bindinput="handleInput"
                />
                <view wx:if="{{ready && !alreadyMine && !submitting}}" class="random-btn" bindtap="handleRandom">
                    <text>⚄ 随机取名</text>
                </view>
            </view>
            <text wx:if="{{validation}}" class="validation">{{validation}}</text>

            <view class="adopt-button {{buttonDisabled ? 'is-disabled' : ''}}" bindtap="handleAdopt">
                <image class="adopt-button-art" src="/pages/adopt/assets/button.webp" mode="aspectFill"></image>
                <text class="adopt-button-text">{{buttonText}}</text>
            </view>
            <text class="action-note">{{actionNote}}</text>
        </view>
        <view class="footer" style="padding-bottom: {{bottomInset}}px;">
            <view wx:if="{{showBackLink || (notice && noticeKind === 'error')}}" class="back-link" bindtap="handleBack">
                <text>{{showBackLink ? '返回上一页' : '回小窝'}}</text>
            </view>
        </view>
    </view>
</view>
