/* 主视觉与文字共用 4:3 坐标系；安全区和草地单独铺满。 */
.adopt-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #c8df83;
}

/* 主图上缘可伸入安全区 42rpx；标题自带约 62rpx 的图内顶距。 */
.immersive-top {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    background: #98b89b;
}

.immersive-top-art {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 562.5rpx;
    transform: scaleY(-3);
    transform-origin: center top;
    pointer-events: none;
}

.immersive-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #a1c0ac 0%, rgba(161, 192, 172, 0.94) 32%, rgba(161, 192, 172, 0.48) 66%, transparent 100%);
    pointer-events: none;
}

.scene {
    position: relative;
    width: 100%;
    height: 562.5rpx;
    flex-shrink: 0;
    overflow: hidden;
}

.scene-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.scene-title {
    position: absolute;
    left: 29%;
    top: 11%;
    width: 39%;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #8c5a36;
    font-family: "Kaiti SC", "STKaiti", "Songti SC", serif;
    font-size: 54rpx;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 2rpx;
    text-shadow: 0 1rpx 0 #f1c5a8;
}

.scene-subtitle {
    position: absolute;
    left: 20%;
    top: 37%;
    width: 60%;
    text-align: center;
    color: #80512e;
    font-size: 24rpx;
    font-weight: 600;
}

.scroll-card {
    position: absolute;
    left: 66.5%;
    top: 39%;
    width: 29%;
    height: 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    padding: 16rpx 6rpx;
    color: #754a29;
}

.scroll-name {
    font-family: "Kaiti SC", "STKaiti", "Songti SC", serif;
    font-size: 32rpx;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
}

.scroll-divider {
    width: 72%;
    height: 1rpx;
    margin: 10rpx 0;
    border-top: 1rpx dashed #bf8b60;
}

.scroll-city,
.scroll-detail {
    font-size: 22rpx;
    line-height: 1.6;
    text-align: center;
}

.trait-row {
    position: absolute;
    left: 4.5%;
    bottom: 1%;
    width: 91%;
    height: 62rpx;
}

.trait-label {
    position: absolute;
    left: 0;
    top: 0;
    width: 16%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #754a29;
    font-size: 20rpx;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
}

.trait-pill {
    position: absolute;
    top: 0;
    width: 25%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #754a29;
    font-size: 20rpx;
    font-weight: 600;
    white-space: nowrap;
}

.pill-0 { left: 17.2%; }
.pill-1 { left: 45%; }
.pill-2 { left: 72.5%; }

.notice {
    position: relative;
    z-index: 2;
    margin: 12rpx 20rpx 0;
    padding: 18rpx 24rpx;
    border-radius: 18rpx;
    background: #fff6e7;
    color: #695337;
    font-size: 26rpx;
    line-height: 1.7;
}

.notice-error {
    background: #fff0e8;
    color: #a0452c;
}

.retry {
    display: inline-block;
    margin-top: 12rpx;
    padding: 12rpx 22rpx;
    border: 1rpx solid #d4dfb8;
    border-radius: 16rpx;
    background: #edf2d8;
    color: #4e6e35;
    font-size: 26rpx;
}

.details {
    position: relative;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #c8df83;
}

.details-top {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.details-bottom {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 44%);
}

.form {
    position: relative;
    z-index: 2;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding: 88rpx 40rpx 42rpx;
}

.name-heading {
    margin-bottom: 18rpx;
    text-align: center;
    color: #754a29;
    font-size: 34rpx;
    font-weight: 700;
}

.name-field {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 88rpx;
    border: 1rpx solid #fff9f1;
    border-radius: 999rpx;
    background: #fffaf4;
    box-shadow: inset 0 2rpx 4rpx rgba(168, 127, 87, 0.16);
    overflow: hidden;
}

.name-input {
    flex: 1;
    height: 100%;
    padding: 0 28rpx;
    color: #785234;
    font-size: 30rpx;
}

.name-placeholder {
    color: #b49b85;
}

.random-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 36%;
    height: 76%;
    border-left: 1rpx dashed #c3946f;
    color: #785234;
    font-size: 26rpx;
    font-weight: 600;
    white-space: nowrap;
}

.validation {
    margin-top: 12rpx;
    padding: 12rpx 18rpx;
    border-radius: 10rpx;
    background: #fff4eb;
    color: #a0452c;
    font-size: 24rpx;
}

.adopt-button {
    position: relative;
    height: 96rpx;
    margin-top: 20rpx;
    border-radius: 999rpx;
    background: #8eab30;
    box-shadow: 0 5rpx 12rpx rgba(116, 143, 59, 0.2);
    overflow: hidden;
}

.adopt-button.is-disabled {
    opacity: 0.72;
}

.adopt-button-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0.32;
}

.adopt-button-text {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff9df;
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
    text-shadow: 0 1rpx 1rpx #6d812b;
}

.action-note {
    margin-top: 16rpx;
    text-align: center;
    color: #6b7c4a;
    font-size: 20rpx;
    line-height: 1.5;
}

.footer {
    position: relative;
    z-index: 2;
    margin-bottom: 22rpx;
}

/* 只在站内跳转时显示，背景照常铺进底部手势区。 */
.back-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #6b7c4a;
    font-size: 24rpx;
}
