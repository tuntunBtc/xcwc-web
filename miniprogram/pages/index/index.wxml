<!-- 小窝：按网页端 src/nest/template.html + nest.css 的叠层结构复刻。
     WXSS 不能可靠引用本地 background-image，故所有纹理与雪碧图改用 <image> + 裁切框。 -->
<!-- 全屏底图：自定义 tabBar 是透明毛绒底板，背景必须铺满整个视口（含底栏区域），
     否则内容区在底栏上沿截断，底栏附近会露出纯色空缺。整页只保留这一张图，
     不另在 .nest 内重复拉伸一份，避免底栏上沿出现接缝。 -->
<image class="page-scene" src="/assets/nest/background.webp" mode="scaleToFill" style="height:{{layout.viewportHeight}}rpx"></image>
<view class="nest" style="height:{{layout.pageHeight}}rpx">

    <view class="scene-shade"></view>

    <!-- 顶部 HUD：头像 / 名字 / 城市 / 相伴 / 切换 / 叽分钱包 -->
    <view class="hud" style="top:{{layout.hudTop}}rpx">
        <view class="identity" bindtap="onSwitch" hover-class="ui-hover">
            <image class="tex-bg" src="/assets/nest/pill.webp" mode="scaleToFill"></image>
            <view class="avatar"><image src="/assets/nest/avatar.webp" mode="aspectFill"></image></view>
            <view class="identity-text">
                <view class="name" catchtap="onRename"><text class="name-text">{{displayName}}</text><text class="pen">✎</text></view>
                <text class="place">{{placeText}}</text>
            </view>
            <view class="companion">
                <view class="clip hud-clip"><image class="sprite icon-companion" src="/assets/nest/hud-icons.webp" mode="scaleToFill"></image></view>
                <text class="companion-text">相伴</text>
            </view>
            <text class="switch">›</text>
        </view>
        <view class="wallet" bindtap="onWallet" hover-class="ui-hover">
            <image class="tex-bg" src="/assets/nest/pill.webp" mode="scaleToFill"></image>
            <view class="clip feather-clip"><image class="sprite icon-feather" src="/assets/nest/hud-icons.webp" mode="scaleToFill"></image></view>
            <view class="wallet-num"><text class="points">{{points}}</text><text class="unit">叽分</text></view>
            <text class="wallet-plus">＋</text>
        </view>
    </view>

    <!-- 三条状态进度 -->
    <view class="status" style="top:{{layout.statusTop}}rpx">
        <view class="stat" wx:for="{{stats}}" wx:key="key">
            <image class="tex-bg" src="/assets/nest/pill.webp" mode="scaleToFill"></image>
            <view class="stat-line">
                <view class="clip stat-icon-clip"><image class="sprite {{item.iconClass}}" src="/assets/nest/hud-icons.webp" mode="scaleToFill"></image></view>
                <text class="stat-label">{{item.label}}</text>
                <text class="stat-value">{{item.text}}</text>
            </view>
            <view class="stat-track"><view class="stat-fill" style="width:{{item.percent}}%"></view></view>
        </view>
    </view>

    <!-- 需求气泡 -->
    <view class="needs" style="top:{{layout.needsTop}}rpx" wx:if="{{needs.length > 0}}">
        <view wx:for="{{needs}}" wx:key="key" class="need {{item.isCurrent ? 'is-current' : ''}}" data-key="{{item.key}}" bindtap="onNeed" hover-class="ui-hover">{{item.label}}</view>
    </view>

    <!-- 右侧工具列 -->
    <view class="tools" style="top:{{layout.toolsTop}}rpx">
        <view wx:for="{{tools}}" wx:key="key" class="tool" data-key="{{item.key}}" bindtap="onTool" hover-class="tool-hover">
            <image class="tex-bg" src="/assets/nest/cloud.webp" mode="scaleToFill"></image>
            <view class="clip tool-prop-clip"><image class="sprite {{item.propClass}}" src="/assets/nest/tools.webp" mode="scaleToFill"></image></view>
            <text class="tool-label">{{item.label}}</text>
            <view wx:if="{{item.key === 'supply' && !supplyClaimed}}" class="tool-dot"></view>
        </view>
    </view>

    <!-- 对话气泡 -->
    <view class="speech" style="top:{{layout.speechTop}}rpx">
        <image class="tex-bg" src="/assets/nest/bubble.webp" mode="scaleToFill"></image>
        <text class="speech-text">{{speech}}</text>
    </view>

    <!-- 空态领取入口 -->
    <view wx:if="{{!hasBird}}" class="claim-help" style="top:{{layout.claimTop}}rpx" bindtap="onClaimHelp" hover-class="ui-hover">如何领取小鸟</view>

    <!-- 小鸟立绘 -->
    <view class="actor {{hasBird ? 'has-bird' : ''}} {{happy ? 'is-happy' : ''}} {{motionPaused ? 'motion-paused' : ''}}" style="top:{{layout.actorTop}}rpx;height:{{layout.actorHeight}}rpx">
        <view class="shadow {{hasBird ? '' : 'is-hidden'}}"></view>
        <view class="grass {{hasBird ? '' : 'is-hidden'}}">
            <view class="blade b1"></view><view class="blade b2"></view>
            <view class="blade b3"></view><view class="blade b4"></view>
        </view>
        <view class="bird-hit" bindtap="onPet" hover-class="none">
            <!-- 待机动画播放时隐藏静态表情海报，避免动画小鸟与表情海报重叠（动画画布覆盖在立绘之上）。 -->
            <image class="bird-art {{idlePlaying ? 'is-hidden' : ''}}" src="{{birdArt}}" mode="aspectFit"></image>
        </view>
        <!-- 画布支持穿透时由 bird-hit 接收，画布直接命中时也触发同一个摸摸动作。 -->
        <canvas wx:if="{{hasBird}}" type="2d" id="idleCanvas" class="idle-canvas" bindtap="onPet"></canvas>
        <!-- 首次自动播放被系统策略拦截时，给出手动入口（仅在已加载成功但被拦截时出现）。 -->
        <view wx:if="{{showIdleButton}}" class="idle-retry" catchtap="onIdleRetry">▶ 播放动画</view>
        <view wx:if="{{feedFxId > 0}}" class="feed-fx">🌾</view>
        <!-- 添水动效：三滴水滴错峰落下（配合 wx:if 重挂载重复触发）；与口渴状态的静态 💧 互不干扰。 -->
        <view wx:if="{{waterFxId > 0}}" class="water-fx">
            <view class="drop d1"></view><view class="drop d2"></view><view class="drop d3"></view>
        </view>
        <text class="hearts">♡</text>
        <text wx:if="{{thirsty}}" class="drops">💧</text>
    </view>

    <!-- 底部三按钮 dock -->
    <view class="dock" style="bottom:{{layout.dockBottom}}rpx">
        <view wx:for="{{dock}}" wx:key="key" class="dock-btn" data-key="{{item.key}}" bindtap="onDock" hover-class="dock-hover">
            <image class="dock-sheet {{item.cardClass}}" src="/assets/nest/cards.webp" mode="scaleToFill"></image>
            <text class="dock-label">{{item.label}} <text class="dock-arrow">›</text></text>
            <!-- 喂食按钮右上角：剩余食物份数角标（红底白字，0 份转灰） -->
            <view wx:if="{{item.key === 'feed'}}" class="dock-badge {{food === 0 ? 'is-empty' : ''}}">{{food}}</view>
        </view>
    </view>
</view>

<!-- 浮层放在场景容器之外，避免被 .nest 的 overflow:hidden 裁剪 -->
<!-- 轻提示 -->
<view wx:if="{{toast}}" class="toast" style="bottom:{{layout.toastBottom}}rpx">{{toast}}</view>

    <!-- 底部弹出面板（网页端 <dialog> 的等价实现） -->
    <view wx:if="{{sheet}}" class="sheet-mask" style="bottom:{{sheetMaskBottom}}rpx" bindtap="closeSheet">
        <view class="sheet" catchtap="noop">
            <view class="sheet-handle"></view>
            <view class="sheet-close" catchtap="closeSheet">×</view>
            <text class="sheet-title">{{sheet.title}}</text>
            <text wx:if="{{sheet.desc}}" class="sheet-desc">{{sheet.desc}}</text>

            <block wx:if="{{sheet.type === 'rename'}}">
                <input class="sheet-input" value="{{renameValue}}" bindinput="onRenameInput" maxlength="6" placeholder="1–6 个字" />
                <view class="sheet-primary" catchtap="onSaveRename">保存昵称</view>
            </block>

            <block wx:if="{{sheet.type === 'wallet'}}">
                <view class="sheet-row"><text>当前余额</text><text>{{points}} 叽分</text></view>
                <view class="sheet-row"><text>今日获得</text><text>{{todayPoints}} / {{dailyLimit}}</text></view>
                <view class="sheet-row"><text>步数兑换</text><text>{{todayStepClaimed ? '今日已兑换' : '今日未兑换'}}</text></view>
                <text class="sheet-subtitle">叽分记录</text>
                <view wx:if="{{ledger.length > 0}}" class="ledger">
                    <view class="sheet-row" wx:for="{{ledger}}" wx:key="id"><text>{{item.note}} · {{item.day}}</text><text>{{item.amountText}}</text></view>
                </view>
                <text wx:else class="sheet-desc">还没有叽分记录</text>
                <view class="sheet-secondary {{todayStepClaimed || redeeming ? 'is-disabled' : ''}}" catchtap="onRedeemSteps">{{todayStepClaimed ? '今日已兑换' : (redeeming ? '兑换中…' : '兑换今日步数')}}</view>
            </block>

            <block wx:if="{{sheet.type === 'supply'}}">
                <view class="sheet-row"><text>食物剩余</text><text>{{food}} 份</text></view>
                <view class="sheet-row"><text>水剩余</text><text>{{water}} 份</text></view>
                <view class="sheet-primary {{supplyClaimed ? 'is-disabled' : ''}}" catchtap="onSupply">{{supplyClaimed ? '今日已补给' : '领取今日补给 · 各 +1'}}</view>
                <text class="sheet-note">每只小鸟每天可免费领取食物和水各 1 份。</text>
            </block>

            <block wx:if="{{sheet.type === 'switch'}}">
                <text class="sheet-desc">本机调试版为单鸟模型，当前伙伴：</text>
                <view class="bird-choice">
                    <image src="/assets/nest/avatar.webp" mode="aspectFit"></image>
                    <view><text class="choice-name">{{displayName}}</text><text class="choice-meta">{{birdCodeShort}}</text></view>
                </view>
                <view class="sheet-secondary" catchtap="goAdopt">从实体标签领养</view>
            </block>

            <block wx:if="{{sheet.type === 'claim'}}">
                <text class="sheet-desc">1. 用支持 NFC 的手机碰一碰实体小鸟，打开系统弹出的链接；或扫描小鸟的小程序码。</text>
                <text class="sheet-desc">2. 在领取页确认资料与昵称，免费孵化后回到小窝。</text>
                <text class="sheet-desc">领取无需登录。小鸟、叽分与合照仅保存在本机，换设备不会自动恢复。</text>
                <view class="sheet-primary" catchtap="goAdopt">查看领养页（调试示例编码）</view>
            </block>

            <block wx:if="{{sheet.type === 'info'}}">
                <view class="sheet-primary" catchtap="closeSheet">知道啦</view>
            </block>
        </view>
    </view>
