<image wx:if="{{osmanthusBackdropActive}}" id="osmanthus-backdrop" class="page-scene" src="{{birdScenePoster}}" data-src="{{birdScenePoster}}" mode="aspectFill" style="height:{{layout.sceneHeight || layout.viewportHeight}}rpx" binderror="onOsmanthusBackdropError"></image>
<image wx:else class="page-scene corgi-poster" src="{{corgiPoster}}" mode="aspectFill" style="height:{{layout.sceneHeight || layout.viewportHeight}}rpx"></image>
<video wx:for="{{corgiClips}}" wx:key="token" id="corgi-player" class="page-scene corgi-player {{corgiPlaying ? 'is-playing' : ''}}"
    style="height:{{layout.sceneHeight || layout.viewportHeight}}rpx" data-token="{{item.token}}" src="{{item.url}}"
    muted="{{!!sheet || item.sound === false}}" autoplay="{{!sheet}}" loop="{{item.loop}}" controls="{{false}}"
    object-fit="cover" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
    enable-progress-gesture="{{false}}" show-mute-btn="{{false}}" bindplay="onCorgiPlay" bindtimeupdate="onCorgiFrame"
    bindended="onCorgiEnded" binderror="onCorgiError"></video>
<view class="corgi-shade"></view>
<view class="nest" style="height:{{layout.pageHeight}}rpx" capture-bind:touchstart="onNestTouch">
    <view wx:if="{{osmanthusBackdropActive}}" id="osmanthus-scene-touch" class="osmanthus-scene-touch" aria-role="button" aria-label="与桂花鸟互动" catchtap="touchBirdScene"></view>
    <!-- 顶部 HUD：头像 / 名字 / 城市 / 火花 / 切换 / 叽分钱包 -->
    <view class="hud" style="top:{{layout.hudTop}}rpx;left:{{layout.hudLeft}}rpx;right:{{layout.hudRight}}rpx">
        <view class="identity" bindtap="onSwitch" hover-class="ui-hover">
            <view class="avatar corgi-avatar" role="button" aria-label="切换小鸟" catchtap="onSwitch"><image src="{{hasBird && avatar ? avatar : (osmanthusBackdropActive ? birdAwakePoster : corgiPoster)}}" mode="aspectFill"></image></view>
            <view class="identity-text" catchtap="onRename">
                <view class="name"><text class="name-text">{{hasBird ? displayName : (osmanthusBackdropActive ? '桂花鸟' : '柯基')}}</text><text class="pen">✎</text></view>
                <text class="place">{{placeText}}</text>
            </view>
            <view class="companion spark-entry" role="button" aria-label="{{'陪伴火花，' + sparkDisplay.badge}}" catchtap="onOpenSpark" hover-class="ui-hover">
                <image class="spark-icon" src="{{sparkDisplay.dim ? '/assets/nest/line-icons/spark-dim.png' : '/assets/nest/line-icons/spark-active.png'}}" mode="aspectFit" aria-hidden="true"></image>
                <text class="companion-text">{{sparkDisplay.badge}}</text>
            </view>
            <text class="switch">›</text>
        </view>
        <view class="wallet" bindtap="onWallet" hover-class="ui-hover">
            <image class="feather-clip" src="/assets/nest/line-icons/feather.png" mode="aspectFit"></image>
            <view class="wallet-num"><text class="points">{{points}}</text><text class="unit">叽分</text></view>
            <text class="wallet-plus">＋</text>
        </view>
    </view>

    <!-- 三组状态 -->
    <view class="status {{osmanthusBackdropActive ? 'bird-pass-through' : ''}}" style="top:{{layout.statusTop}}rpx">
        <view class="stat" wx:for="{{stats}}" wx:key="key">
            <view class="stat-line">
                <image class="stat-icon-clip" src="/assets/nest/line-icons/{{item.key}}.png" mode="aspectFit"></image>
                <text class="stat-label">{{item.label}}</text>
                <text class="stat-value">{{item.text}}</text>
            </view>
        </view>
    </view>

    <!-- 右侧工具列 -->
    <view wx:if="{{!corgiMenuOpen}}" class="tools" style="top:{{layout.toolsTop}}rpx">
        <view wx:for="{{tools}}" wx:key="key" class="tool {{item.key === 'diary' ? 'tool-diary' : ''}}" data-key="{{item.key}}" bindtap="onTool" hover-class="tool-hover" aria-role="button" aria-label="{{item.label}}">
            <view wx:if="{{item.key === 'diary'}}" class="diary-icon" aria-hidden="true">
                <view class="diary-ring ring-one"></view><view class="diary-ring ring-two"></view><view class="diary-ring ring-three"></view>
                <view class="diary-line line-one"></view><view class="diary-line line-two"></view>
            </view>
            <image wx:elif="{{item.key === 'supply' || item.key === 'checkin' || item.key === 'ar' || item.key === 'video'}}" class="tool-prop-clip" src="/assets/nest/line-icons/{{item.key}}.png" mode="aspectFit"></image>
            <block wx:else>
                <image class="tex-bg" src="/assets/nest/cloud.webp" mode="scaleToFill"></image>
                <view class="clip tool-prop-clip"><image class="sprite {{item.propClass}}" src="/assets/nest/tools.webp" mode="scaleToFill"></image></view>
                <text class="tool-label">{{item.label}}</text>
            </block>
            <view wx:if="{{item.key === 'supply' && hasBird && !supplyClaimed}}" class="tool-dot"></view>
        </view>
    </view>
</view>

<!-- 未登录时将登录入口放在底部导航两项之间。 -->
<button wx:if="{{cloudStatus && !cloudStatus.signedIn && !sheet && !corgiMenuOpen}}" class="nest-login-entry" catchtap="onNestLogin" loading="{{nestLoginBusy}}" disabled="{{nestLoginBusy}}">微信登录</button>

<block wx:if="{{corgiMenuOpen}}">
    <view class="corgi-menu-backdrop" catchtap="toggleCorgiMenu"></view>
    <view wx:if="{{!corgiJob}}" class="corgi-menu" style="bottom:{{(layout.tabBarHeight || 149) + 8}}rpx">
        <view class="corgi-tabs">
            <view id="corgi-tab-actions" class="corgi-tab {{corgiCategory === 'actions' ? 'is-active' : ''}}" aria-role="button" data-category="actions" catchtap="selectCorgiCategory">互动</view>
            <view id="corgi-tab-states" class="corgi-tab {{corgiCategory === 'states' ? 'is-active' : ''}}" aria-role="button" data-category="states" catchtap="selectCorgiCategory">养成与状态</view>
            <view id="corgi-tab-work" class="corgi-tab {{corgiCategory === 'work' ? 'is-active' : ''}}" aria-role="button" data-category="work" catchtap="selectCorgiCategory">打工</view>
            <view id="corgi-tab-bird" class="corgi-tab {{corgiCategory === 'bird' ? 'is-active' : ''}}" aria-role="button" data-category="bird" catchtap="selectCorgiCategory">小鸟互动</view>
            <view id="osmanthus-backdrop-toggle" class="corgi-tab" aria-role="button" catchtap="toggleOsmanthusBackdrop" hover-class="corgi-pressed">{{osmanthusBackdropActive ? '切回柯基' : '桂花鸟背景'}}</view>
        </view>
        <view wx:if="{{corgiCategory === 'work'}}" class="corgi-jobs">
            <view wx:for="{{corgiJobs}}" wx:key="key" id="corgi-job-{{item.key}}" class="corgi-job-card" data-job="{{item.key}}" aria-role="button" aria-label="{{item.label}}" catchtap="selectCorgiJob" hover-class="corgi-pressed">
                <image class="corgi-job-thumb" src="{{item.photos[0]}}" mode="aspectFit"></image>
                <text class="corgi-job-name">{{item.label}}</text>
            </view>
            <view id="corgi-work-menu-close" class="corgi-job-dismiss" aria-role="button" catchtap="toggleCorgiMenu">收起</view>
        </view>
        <view wx:else class="corgi-grid">
            <view wx:for="{{corgiActions}}" wx:key="key" id="corgi-{{item.key}}" class="corgi-choice" role="button"
                aria-label="{{item.key === 'close' ? '收起互动' : item.label}}" data-key="{{item.key}}" catchtap="playCorgiAction" hover-class="corgi-pressed">
                <view class="corgi-disc {{item.key === 'close' ? 'corgi-disc-close' : ''}}"><view class="corgi-symbol ci-{{item.icon || item.key}}"></view></view>
                <text class="corgi-label">{{item.label}}</text>
            </view>
        </view>
    </view>
    <view wx:else class="corgi-work-view" style="bottom:{{(layout.tabBarHeight || 149) + 8}}rpx;top:{{layout.hudTop || 124}}rpx">
        <view class="corgi-work-album">
            <view class="corgi-work-toolbar">
                <text class="corgi-work-heading">{{corgiJob.label}}</text>
                <view id="corgi-work-close" class="corgi-work-close" aria-role="button" aria-label="关闭打工相册" catchtap="closeCorgiWork">×</view>
            </view>
            <swiper id="corgi-work-swiper" class="corgi-work-swiper" circular autoplay interval="3000" duration="330" data-job="{{corgiJob.key}}" bindchange="changeCorgiWorkPhoto">
                <swiper-item wx:for="{{corgiJob.photos}}" wx:key="*this">
                    <image class="corgi-work-photo" src="{{item}}" mode="aspectFit"></image>
                </swiper-item>
            </swiper>
            <view class="corgi-work-footer">
                <view id="corgi-work-back" class="corgi-work-back" aria-role="button" catchtap="leaveCorgiJob">‹ 选择岗位</view>
                <text class="corgi-work-count">{{corgiWorkIndex + 1}} / {{corgiJob.photos.length}}</text>
            </view>
        </view>
    </view>
</block>

<!-- 浮层放在场景容器之外，避免被 .nest 的 overflow:hidden 裁剪 -->
<!-- 轻提示 -->
<view wx:if="{{toast}}" class="toast" style="bottom:{{layout.toastBottom}}rpx">{{toast}}</view>

    <!-- 底部弹出面板（网页端 <dialog> 的等价实现） -->
    <view wx:if="{{sheet}}" class="sheet-mask glass-mask" style="bottom:{{sheetMaskBottom}}rpx;padding-top:{{layout.inset}}rpx" bindtap="closeSheet">
        <view class="sheet nest-glass {{sheet.type}}-glass" catchtap="noop">
            <view class="sheet-handle"></view>
            <view class="sheet-close" catchtap="closeSheet">×</view>
            <text class="sheet-title">{{sheet.title}}</text>
            <text wx:if="{{sheet.desc}}" class="sheet-desc">{{sheet.desc}}</text>

            <block wx:if="{{sheet.type === 'login'}}">
                <button class="sheet-primary" catchtap="onNestLogin" loading="{{nestLoginBusy}}" disabled="{{nestLoginBusy}}">微信登录</button>
                <button class="sheet-secondary" catchtap="closeSheet">先逛逛</button>
            </block>

            <block wx:if="{{sheet.type === 'spark'}}">
                <view wx:if="{{sparkDisplay.mode === 'ready'}}" class="spark-summary">
                    <view class="spark-summary-head">
                        <text class="spark-bird">{{displayName}}</text>
                        <text class="spark-today">{{sparkDisplay.spark.effectiveToday ? '今日已完成' : '今日待互动'}}</text>
                    </view>
                    <view class="spark-metrics">
                        <view class="spark-metric">
                            <text class="spark-metric-label">火花等级</text>
                            <text class="spark-metric-value">{{sparkDisplay.spark.level ? 'Lv.' + sparkDisplay.spark.level : '未点亮'}}</text>
                        </view>
                        <view class="spark-metric">
                            <text class="spark-metric-label">火花天数</text>
                            <text class="spark-metric-value">{{sparkDisplay.spark.level}} 天</text>
                        </view>
                        <view class="spark-metric">
                            <text class="spark-metric-label">累计亲密度</text>
                            <text class="spark-metric-value">{{sparkDisplay.spark.affinity}}</text>
                        </view>
                    </view>
                    <view wx:if="{{sparkDisplay.spark.status === 'RECOVERABLE' || sparkDisplay.spark.status === 'RECOVERING'}}" class="spark-recovery">
                        <view class="spark-recovery-label">
                            <text>冻结等级 Lv.{{sparkDisplay.spark.frozenLevel}}</text>
                            <text>恢复 {{sparkDisplay.spark.recoveryProgress}} / 3</text>
                        </view>
                        <view class="spark-progress" aria-hidden="true">
                            <view class="spark-progress-day {{sparkDisplay.spark.recoveryProgress >= 1 ? 'is-done' : ''}}"></view>
                            <view class="spark-progress-day {{sparkDisplay.spark.recoveryProgress >= 2 ? 'is-done' : ''}}"></view>
                            <view class="spark-progress-day"></view>
                        </view>
                        <text wx:if="{{sparkDisplay.deadline}}" class="spark-deadline">{{sparkDisplay.deadline}}</text>
                    </view>
                </view>
                <text class="spark-message">{{sparkDisplay.message}}</text>
                <button class="sheet-primary spark-action" catchtap="onSparkAction"
                    disabled="{{(sparkDisplay.action === 'pet' && !cloudStatus.canOperate) || ((sparkDisplay.action === 'retry' || sparkDisplay.action === 'login') && (cloudStatus.loading || !cloudStatus.online))}}">
                    {{sparkDisplay.button}}
                </button>
            </block>

            <block wx:if="{{sheet.type === 'rename'}}">
                <input class="sheet-input" value="{{renameValue}}" bindinput="onRenameInput" maxlength="12" adjust-position="{{false}}" placeholder="1–6 个字" placeholder-style="color:#c8c4be" />
                <button class="sheet-primary" disabled="{{!cloudStatus.canOperate}}" catchtap="onSaveRename">保存昵称</button>
            </block>

            <block wx:if="{{sheet.type === 'wallet'}}">
                <view class="wallet-overview">
                    <view class="wallet-current">
                        <text class="wallet-label">当前余额</text>
                        <view class="wallet-balance"><text class="wallet-amount">{{points}}</text><text class="wallet-unit">叽分</text></view>
                    </view>
                    <view class="wallet-daily">
                        <text class="wallet-label">今日获得</text>
                        <text class="wallet-daily-amount">{{todayPoints}} / {{dailyLimit}}</text>
                    </view>
                </view>
                <text class="sheet-subtitle">叽分记录</text>
                <view wx:if="{{ledger.length > 0}}" class="ledger">
                    <view class="sheet-row" wx:for="{{ledger}}" wx:key="id">
                        <view class="wallet-record"><text class="wallet-note">{{item.note}}</text><text class="wallet-date">{{item.day}}</text></view>
                        <text class="wallet-change">{{item.amountText}}</text>
                    </view>
                </view>
                <text wx:else class="sheet-desc">还没有叽分记录</text>
                <text wx:if="{{historyError}}" class="sheet-note">{{historyError}}</text>
                <view wx:if="{{historyMore}}" class="sheet-secondary" catchtap="onMoreHistory">加载更多</view>
            </block>

            <block wx:if="{{sheet.type === 'supply'}}">
                <view wx:if="{{testWeRun}}" class="supply-card supply-steps">
                    <view class="supply-card-head">
                        <text class="supply-card-title">微信步数兑换</text>
                        <text class="supply-card-meta">1,000 步兑 1 叽分</text>
                    </view>

                    <block wx:if="{{testSteps !== null}}">
                        <view class="supply-metrics">
                            <view class="supply-metric supply-metric-primary">
                                <text class="supply-metric-label">当前可兑换</text>
                                <text class="supply-metric-value">{{testStepPointsAvailable}}<text class="supply-metric-unit"> 叽分</text></text>
                            </view>
                            <view class="supply-metric">
                                <text class="supply-metric-label">今日步数</text>
                                <text class="supply-metric-value">{{testSteps}}<text class="supply-metric-unit"> 步</text></text>
                            </view>
                            <view class="supply-metric">
                                <text class="supply-metric-label">今日已兑换</text>
                                <text class="supply-metric-value">{{testStepPointsRedeemed}}<text class="supply-metric-unit"> 叽分</text></text>
                            </view>
                        </view>
                        <text wx:if="{{testStepsToNext > 0}}" class="supply-hint">再走 {{testStepsToNext}} 步可多兑 1 叽分</text>
                        <button wx:if="{{testStepPointsAvailable > 0}}" class="supply-button supply-button-primary"
                            disabled="{{testStepBusy || !cloudStatus.online || !cloudStatus.signedIn}}"
                            data-action="redeem" catchtap="onReadTestSteps">{{testStepBusy ? '处理中…' : '兑换 ' + testStepPointsAvailable + ' 叽分'}}</button>
                        <button class="supply-button {{testStepPointsAvailable > 0 ? 'supply-button-text' : 'supply-button-primary'}}"
                            disabled="{{testStepBusy || !cloudStatus.online || !cloudStatus.signedIn}}"
                            catchtap="onReadTestSteps">{{testStepBusy ? '处理中…' : '更新微信步数'}}</button>
                    </block>
                    <block wx:else>
                        <text class="supply-hint">{{!cloudStatus.signedIn ? '微信登录后可读取步数' : '当天可多次兑换，已兑换的步数不会重复计算'}}</text>
                        <button class="supply-button supply-button-primary" disabled="{{testStepBusy || !cloudStatus.online || !cloudStatus.signedIn}}"
                            catchtap="onReadTestSteps">{{testStepBusy ? '正在读取…' : '读取微信步数'}}</button>
                    </block>
                    <text wx:if="{{testStepMessage}}" class="supply-hint supply-message">{{testStepMessage}}</text>
                    <text wx:elif="{{!cloudStatus.online && cloudStatus.signedIn}}" class="supply-hint supply-message">联网后可更新步数并兑换</text>
                    <button wx:if="{{testStepNeedsSetting}}" class="supply-button supply-button-text" catchtap="onTestStepSettings">打开权限设置</button>
                </view>

                <view class="supply-card supply-inventory">
                    <view class="supply-card-head">
                        <text class="supply-card-title">小鸟库存</text>
                        <text class="supply-card-meta">{{displayName}}</text>
                    </view>
                    <view class="supply-stock">
                        <view class="supply-stock-item"><text>食物</text><text class="supply-stock-value">{{food}} 份</text></view>
                        <view class="supply-stock-item"><text>水</text><text class="supply-stock-value">{{water}} 份</text></view>
                    </view>
                    <button class="supply-button supply-button-quiet" disabled="{{!cloudStatus.canOperate || supplyClaimed}}"
                        catchtap="onSupply">{{supplyClaimed ? '今日免费食水已领' : '领取免费食水 · 各 1 份'}}</button>
                </view>

                <view class="supply-history-links">
                    <button class="supply-button supply-button-quiet" data-kind="inventory" catchtap="onHistory">库存流水</button>
                    <button class="supply-button supply-button-quiet" data-kind="claims" catchtap="onHistory">食水领取记录</button>
                </view>
            </block>

            <block wx:if="{{sheet.type === 'switch'}}">
                <scroll-view scroll-y="true" style="max-height:420rpx">
                    <view class="bird-choice {{item.petId === selectedPetId ? 'is-current' : ''}}" aria-role="button" wx:for="{{pets}}" wx:key="petId" data-id="{{item.petId}}" catchtap="onSelectPet">
                        <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFit"></image>
                        <view wx:else class="bird-choice-avatar" aria-hidden="true"></view>
                        <view class="choice-info">
                            <text class="choice-name">{{item.nickname}}</text>
                            <view class="choice-status"><view wx:if="{{item.petId === selectedPetId}}" class="choice-check" aria-hidden="true"></view>{{item.petId === selectedPetId ? '当前陪伴' : '切换陪伴'}}</view>
                        </view>
                        <view class="bird-choice-spark">
                            <view class="spark-icon spark-tier-1 {{item.sparkLit ? '' : 'spark-dim'}}" aria-hidden="true">
                                <view class="spark-flame"></view>
                            </view>
                            <text aria-label="{{item.sparkLevel === null ? '火花等级未知' : '火花等级 ' + item.sparkLevel}}">{{item.sparkLevel === null ? '—' : 'Lv.' + item.sparkLevel}}</text>
                        </view>
                    </view>
                </scroll-view>
                <text class="sheet-note">昵称、库存和养成按小鸟独立保存。</text>
                <view wx:for="{{testAdoptions}}" wx:key="key" class="sheet-primary test-bird-entry" data-key="{{item.key}}" catchtap="goAdopt">{{item.owned ? '查看测试鸟 · ' : '领取测试鸟 · '}}{{item.name}}</view>
            </block>
            <block wx:if="{{sheet.type === 'history'}}">
                <view class="supply-history">
                    <scroll-view wx:if="{{historyItems.length}}" scroll-y="true" class="supply-history-list">
                        <view wx:for="{{historyItems}}" wx:key="index" class="supply-history-row">
                            <block wx:if="{{historyKind === 'inventory'}}">
                                <text class="supply-history-event">{{item.operation === 'INITIAL' ? '初始库存' : item.operation === 'FEED' ? '喂食' : item.operation === 'WATER' ? '添水' : item.operation === 'SUPPLY' || item.operation === 'CLAIM_SUPPLY' ? '领取食水' : item.operation}}</text>
                                <text class="supply-history-detail">食物 {{item.foodDelta > 0 ? '+' : ''}}{{item.foodDelta}}，剩 {{item.foodAfter}} 份</text>
                                <text class="supply-history-detail">水 {{item.waterDelta > 0 ? '+' : ''}}{{item.waterDelta}}，剩 {{item.waterAfter}} 份</text>
                            </block>
                            <block wx:else>
                                <text class="supply-history-event">{{item.date}}</text>
                                <text class="supply-history-detail">食物 +{{item.food}} 份 · 水 +{{item.water}} 份</text>
                            </block>
                        </view>
                    </scroll-view>
                    <text wx:if="{{historyError}}" class="supply-hint supply-message">{{historyError}}</text>
                    <text wx:elif="{{!historyItems.length}}" class="supply-hint">{{historyLoading ? '正在读取记录…' : '暂无记录'}}</text>
                    <view class="supply-history-links">
                        <button class="supply-button supply-button-quiet" catchtap="onOpenSupply">返回补给</button>
                        <button class="supply-button supply-button-quiet" disabled="{{historyLoading}}"
                            catchtap="onMoreHistory">{{historyLoading ? '正在读取…' : historyError ? '重试读取' : historyMore ? '加载更多' : '刷新记录'}}</button>
                    </view>
                </view>
            </block>

            <block wx:if="{{sheet.type === 'claim'}}">
                <text class="sheet-desc">1. 用支持 NFC 的手机碰一碰实体小鸟，打开系统弹出的链接；或扫描小鸟的小程序码。</text>
                <text class="sheet-desc">2. 在领取页确认资料与昵称，免费孵化后回到小窝。</text>
                <text class="sheet-desc">微信登录可恢复云端小鸟与叽分，合照仅保存在本机。</text>
                <view wx:for="{{testAdoptions}}" wx:key="key" class="sheet-primary test-bird-entry" data-key="{{item.key}}" catchtap="goAdopt">{{item.owned ? '查看测试鸟 · ' : '领取测试鸟 · '}}{{item.name}}</view>
                <view wx:if="{{fixtureMode}}" class="sheet-primary" catchtap="goAdopt">查看领养页（调试示例编码）</view>
            </block>

            <block wx:if="{{sheet.type === 'info'}}">
                <view class="sheet-primary" catchtap="closeSheet">知道啦</view>
            </block>
        </view>
    </view>

<view wx:if="{{cloudStatus.signedIn && cloudStatus.pending}}" class="cloud-status cloud-nest-status" style="bottom:{{layout.tabBarHeight + 192}}rpx" role="status">
    <button size="mini" disabled="{{cloudStatus.busy || cloudStatus.loading || !cloudStatus.online}}" bindtap="onCloudRetry">确认上次操作</button>
</view>
