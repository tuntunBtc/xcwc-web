page { background: #f5f0e8; }
button, view, image, text { box-sizing: border-box; }
.diary-page button::after { border: 0; }
/* 正式小程序的 style v2 自带按钮宽度与自动外边距，日历控件按各自布局定宽。 */
.diary-page button {
  width: auto;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  line-height: 1;
  background: none;
  color: inherit;
  font-weight: inherit;
}
.diary-page button[disabled] { background: none; }

.diary-page {
  --wash: #f8eddf;
  --glow: #f3dfc7;
  --ink: #332d37;
  --muted: #6e6473;
  --accent: #6d537b;
  --line: rgba(99, 76, 109, .17);
  --card: rgba(255, 251, 244, .87);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: radial-gradient(ellipse at 84% 4%, var(--glow), transparent 65%), linear-gradient(150deg, var(--wash), #f4f0e9 78%);
  color: var(--ink);
}
.mood-page-calm { --wash: #f0f3ed; --glow: #e2ede4; }
.mood-page-curious { --wash: #eef1f5; --glow: #e0e9f2; }
.mood-page-happy { --wash: #f9ecdd; --glow: #f3dec3; }
.mood-page-proud { --wash: #f3edf6; --glow: #e8d9ed; }
.mood-page-empty { --wash: #f4efe9; --glow: #eee6df; }

.diary-nav {
  display: flex;
  flex: none;
  align-items: center;
  gap: 16rpx;
  padding-left: 28rpx;
  margin-bottom: 17rpx;
}
.diary-page .diary-back {
  width: 64rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  background: rgba(255, 252, 249, .70);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  color: var(--accent);
}
.diary-title { color: var(--ink); font-size: 35rpx; font-weight: 700; white-space: nowrap; }
.chevron { width: 12rpx; height: 12rpx; border: solid currentColor; border-width: 0 3rpx 3rpx 0; }
.chevron-left { transform: rotate(135deg); margin-left: 4rpx; }
.chevron-right { transform: rotate(-45deg); margin-right: 4rpx; }
.chevron-down { transform: rotate(45deg); width: 9rpx; height: 9rpx; margin-top: -4rpx; }
.pressed { opacity: .72; }

.diary-scroll { flex: 1; height: 0; width: 100%; }
.diary-body { padding: 1rpx 28rpx 37rpx; padding-bottom: calc(37rpx + env(safe-area-inset-bottom)); }
.content-top { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; margin-bottom: 15rpx; }
.content-date { font-weight: 600; font-size: 24rpx; color: var(--muted); }
.bird-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 251, 247, .72);
  border: 1rpx solid var(--line);
  padding: 9rpx 16rpx 9rpx 9rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
}
.bird-avatar { width: 39rpx; height: 39rpx; border-radius: 50%; background: #eee6f1; }
.bird-avatar-placeholder { padding: 4rpx; }
.bird-name { max-width: 178rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.calendar-panel {
  padding: 21rpx 20rpx 17rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 249, .65);
  border: 1rpx solid rgba(255, 255, 255, .87);
  box-shadow: 0 7rpx 22rpx rgba(72, 49, 73, .07), inset 0 0 0 1rpx var(--line);
  backdrop-filter: blur(12px);
}
.calendar-top, .calendar-controls { display: flex; align-items: center; justify-content: space-between; }
.calendar-label { font-size: 26rpx; font-weight: 680; }
.view-switch { display: flex; flex: none; padding: 4rpx; border-radius: 21rpx; background: #eee6f0; }
.diary-page .view-switch button {
  width: 77rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  font-size: 22rpx;
  color: var(--accent);
}
.diary-page .view-switch .active { background: #fffbfe; font-weight: 700; box-shadow: 0 2rpx 7rpx rgba(70, 50, 78, .12); }
.calendar-controls { margin: 11rpx 0 4rpx; }
.diary-page .period-button, .diary-page .today-button {
  color: var(--accent);
  border-radius: 32rpx;
  min-width: 56rpx;
  height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 650;
  font-size: 22rpx;
}
.diary-page .period-button[disabled] { opacity: .32; color: var(--accent); }
.diary-page .today-button { padding: 0 24rpx; background: #f0e8f1; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6rpx; }
.weekday-grid { margin-bottom: 7rpx; }
.weekday { text-align: center; color: var(--muted); font-size: 22rpx; line-height: 38rpx; }
.diary-page .day-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  width: 100%;
  max-width: 100%;
  height: 93rpx;
  padding: 9rpx 0 0;
  border-radius: 19rpx;
  border: 1rpx solid rgba(106, 83, 108, .09);
  background: rgba(255,255,255,.44);
  color: var(--ink);
  overflow: hidden;
}
.dates-month .day-cell { height: 79rpx; gap: 4rpx; padding-top: 6rpx; border-radius: 16rpx; }
.day-cell.is-selected { background: #f4e6f6; border-color: #ad8abb; }
.day-cell.is-today .day-number { color: #755687; font-weight: 800; }
.day-cell.outside-month, .day-cell[disabled] { opacity: .44; }
.day-number { font-variant-numeric: tabular-nums; font-size: 24rpx; line-height: 25rpx; font-weight: 650; }
.day-mood {
  position: relative;
  display: inline-block;
  width: 34rpx;
  height: 27rpx;
  border-radius: 45%;
  color: #735b4e;
  background: #f4d8ad;
  box-shadow: inset 0 -3rpx 6rpx rgba(121, 96, 77, .11);
}
.day-cell .calendar-mood {
  flex: none;
  width: 22px;
  height: 17px;
  margin-top: -1px;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.dates-month .calendar-mood { width: 18px; height: 14px; }
.dates-grid .calendar-mood-marked { transform: translateX(-3px); }
.dates-month .calendar-mood-marked { transform: translateX(-2px); }
.mood-calm { background: #dce9da; color: #526752; }
.mood-curious { background: #dbe8f2; color: #4e657a; }
.mood-happy { background: #f5c989; color: #754e36; }
.mood-proud { background: #e6d3ee; color: #644f73; }
.mood-content { background: #f4d7ad; color: #735b4e; }
.mood-empty { background: #e9e5e2; color: #b9b2ae; }
.mood-eyes, .mood-mouth { position: absolute; top: 34%; left: 30%; }
.mood-eyes { width: 3rpx; height: 4rpx; border-radius: 50%; background: currentColor; box-shadow: 11rpx 0 currentColor; }
.mood-mouth { top: 54%; left: 43%; width: 7rpx; height: 5rpx; border-radius: 0 0 65% 65%; border-bottom: 2rpx solid currentColor; }
.mood-curious .mood-mouth { width: 5rpx; height: 5rpx; border: 1.5rpx solid currentColor; border-radius: 50%; }
.mood-happy .mood-mouth, .mood-proud .mood-mouth { background: currentColor; }
.mood-content .mood-eyes { height: 3rpx; }
.mood-empty .mood-mouth { height: 1rpx; border-radius: 0; border-bottom-width: 1rpx; }
.day-mark {
  position: absolute;
  bottom: 4rpx;
  right: 6rpx;
  font-size: 15rpx;
  font-weight: 750;
  line-height: 21rpx;
  height: 21rpx;
  min-width: 22rpx;
  border-radius: 7rpx;
  background: #edf0e7;
  color: #526344;
}
.day-mark-travel, .legend-travel { background: #f1dfc4; color: #764e2d; }
.day-mark-study, .legend-study { background: #e9def0; color: #66477b; }
.day-mark-paired { right: 4rpx; min-width: 20rpx; }
.day-mark-extra { bottom: 28rpx; }
.day-unread, .legend-unread { width: 11rpx; height: 11rpx; border-radius: 50%; background: #a94857; }
.day-unread { position: absolute; top: 8rpx; right: 7rpx; border: 1rpx solid #fffbf6; }
.calendar-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 11rpx 22rpx; padding-top: 15rpx; color: var(--muted); font-size: 20rpx; }
.calendar-legend > view { display: flex; align-items: center; gap: 6rpx; }
.legend-travel, .legend-study { width: 29rpx; height: 26rpx; line-height: 26rpx; text-align: center; border-radius: 7rpx; font-weight: 700; font-size: 16rpx; }
.legend-unread { margin: 0 5rpx; }

.diary-day-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 22rpx 2rpx 11rpx; }
.diary-date { font-size: 29rpx; font-weight: 700; }
.diary-date text { font-size: 21rpx; font-weight: 450; color: var(--muted); margin-left: 13rpx; }
.day-navigation { display: flex; flex: none; gap: 7rpx; }
.diary-page .day-navigation .period-button { background: rgba(255, 253, 250, .7); border: 1rpx solid var(--line); }
.diary-card, .diary-empty, .reply-card, .note-card {
  background: var(--card);
  border: 1rpx solid rgba(255,255,255,.93);
  border-radius: 34rpx;
  box-shadow: 0 9rpx 25rpx rgba(85, 55, 79, .10);
}
.diary-card, .diary-empty { padding: 19rpx 23rpx 21rpx; touch-action: pan-y; }
.diary-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 15rpx; }
.card-mood { display: flex; align-items: center; gap: 10rpx; color: var(--ink); font-size: 24rpx; font-weight: 680; }
.card-mood .day-mood { transform: scale(1.15); margin: 2rpx 3rpx; }
.diary-kicker { font-weight: 600; color: var(--accent); font-size: 22rpx; }
.diary-card-title { margin-top: 17rpx; font-size: 38rpx; line-height: 1.24; font-weight: 760; }
.diary-copy { font-size: 27rpx; line-height: 1.66; margin-top: 11rpx; color: #504650; white-space: pre-wrap; word-break: break-word; }
.diary-activity { margin-top: 17rpx; padding: 17rpx 15rpx; border: 1rpx solid var(--line); border-radius: 16rpx; }
.diary-activity-type { display: inline-block; border-radius: 8rpx; padding: 4rpx 8rpx; font-size: 20rpx; }
.diary-activity-title { margin-top: 9rpx; color: var(--ink); font-size: 25rpx; font-weight: 650; }
.diary-empty { min-height: 183rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 13rpx; font-size: 30rpx; font-weight: 650; }
.diary-empty text { color: var(--muted); font-size: 23rpx; font-weight: 400; }
.diary-inline-status { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 8rpx 0; font-size: 22rpx; color: var(--muted); }
.diary-page .diary-retry { flex: none; padding: 10rpx 18rpx; border-radius: 22rpx; background: #f0e8f1; color: var(--accent); font-size: 22rpx; }
.note-card { margin-top: 20rpx; padding: 19rpx 23rpx; }
.note-title { font-size: 27rpx; font-weight: 680; }
.note-input { box-sizing: border-box; width: 100%; height: 120rpx; margin-top: 11rpx; padding: 14rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fffdf9; color: var(--ink); font-size: 25rpx; }
.note-footer { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; margin-top: 12rpx; }
.note-feedback { flex: 1; font-size: 21rpx; color: var(--muted); }
.note-failed { color: #a94857; }
.diary-page .note-submit { flex: none; min-height: 56rpx; padding: 12rpx 19rpx; border-radius: 20rpx; background: var(--accent); color: #fff; font-size: 22rpx; font-weight: 650; }
.diary-page .note-submit[disabled] { background: #f0e8f1; color: var(--muted); }
.reply-card { margin: 20rpx 0 0; padding: 12rpx 19rpx; }
.reply-owner { padding: 8rpx 4rpx 12rpx; border-bottom: 1rpx solid var(--line); color: #504650; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
.reply-owner text { color: var(--muted); font-size: 20rpx; }
.diary-page .reply-open { width: 100%; min-height: 73rpx; display: flex; align-items: center; gap: 16rpx; text-align: left; }
.reply-icon { width: 38rpx; height: 28rpx; border: 2rpx solid #976c94; border-radius: 7rpx; background: #f1e5ef; position: relative; flex: 0 0 38rpx; }
.reply-icon::after { content: ""; width: 17rpx; height: 17rpx; position: absolute; top: -7rpx; left: 8rpx; border: solid #976c94; border-width: 0 2rpx 2rpx 0; transform: rotate(45deg); }
.reply-caption { flex: 1; display: flex; flex-direction: column; gap: 8rpx; font-size: 26rpx; font-weight: 650; }
.reply-caption text { font-size: 20rpx; color: var(--muted); }
.reply-caption .reply-unread { color: #a94857; }
.reply-action { color: var(--accent); padding: 10rpx 13rpx; border-radius: 20rpx; background: #f1e7f2; font-size: 21rpx; font-weight: 600; }
.reply-body { margin: 7rpx 0; padding: 17rpx 4rpx 7rpx; border-top: 1rpx solid var(--line); color: #504650; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
