<!-- 自定义 tabBar 组件由框架注入每个 tab 页：
     spacer 在正常文档流里预留底栏高度，fixed 层负责毛绒底栏的渲染。
     底板保持 960×195 原始比例贴在窗口物理底边，四个入口与底板同轴垂直居中；
     上方多出的 Home Indicator 安全区不画底板、也不拦截页面点击。 -->
<view class="tab-bar-space" style="height: {{barHeight}}rpx"></view>
<view class="tab-bar" style="height: {{barHeight}}rpx">
    <image class="tab-bar-art" src="/assets/navigation/plush/nav-background.webp" mode="scaleToFill"></image>
    <view class="tab-bar-items">
        <view class="tab-bar-item" wx:for="{{list}}" wx:key="pagePath"
              data-path="{{item.pagePath}}" data-index="{{index}}"
              bindtap="switchTab" hover-class="tab-bar-item-hover" hover-stay-time="80">
            <image class="tab-bar-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
            <text class="tab-bar-text {{selected === index ? 'is-active' : ''}}">{{item.text}}</text>
        </view>
    </view>
</view>
