page {
    min-height: 100%;
    background: #F5F3EC;
    color: #2F3329;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 28rpx 56rpx;
}

.card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 28rpx;
    border: 2rpx solid #E7E2D5;
    border-radius: 28rpx;
    background: #FFFDF8;
}

.eyebrow {
    color: #7C8C6B;
    font-size: 22rpx;
    letter-spacing: 2rpx;
}

.title {
    margin-top: 10rpx;
    font-size: 40rpx;
    font-weight: 600;
    line-height: 1.3;
}

.subtitle,
.muted {
    color: #8A8578;
    font-size: 26rpx;
    line-height: 1.6;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.row + .row {
    margin-top: 18rpx;
}

.badge {
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    background: #EAF0E2;
    color: #4F6A3E;
    font-size: 24rpx;
}

.btn {
    margin: 0;
    padding: 0 24rpx;
    border-radius: 20rpx;
    font-size: 28rpx;
    line-height: 76rpx;
    height: 76rpx;
}

.btn-primary {
    background: #5F7A4F;
    color: #FFFFFF;
}

.btn-ghost {
    background: #EFEDE3;
    color: #2F3329;
}

.btn[disabled] {
    opacity: 0.5;
}

.btn-row {
    display: flex;
    margin-top: 24rpx;
}

.btn-row .btn {
    flex: 1;
}

.btn-row .btn + .btn {
    margin-left: 16rpx;
}

button::after {
    border: none;
}

.divider {
    height: 2rpx;
    margin: 24rpx 0;
    background: #EFEDE3;
}

.state-card {
    box-sizing: border-box;
    min-height: 280rpx;
    padding: 36rpx;
    border: 2rpx solid #E7E2D5;
    border-radius: 28rpx;
    background: #FFFDF8;
    text-align: center;
}

.state-title {
    margin-top: 20rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.state-description {
    margin-top: 12rpx;
    color: #8A8578;
    font-size: 26rpx;
    line-height: 1.6;
}
